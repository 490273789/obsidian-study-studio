{
	"name": "study-studio",
	"version": "6.2.0",
	"description": "A flashcard learning plugin for Obsidian based on FSRS algorithm",
	"keywords": [],
	"license": "0-BSD",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "vp build --watch --mode development",
		"test": "vp test run && node scripts/verify-commit-msg.test.mjs",
		"test:watch": "vp test watch",
		"dictionary:engine": "node scripts/build-dictionary-engine.mjs",
		"build": "tsc --noEmit --skipLibCheck && vp build",
		"artifacts:check": "node scripts/check-artifact-size.mjs",
		"architecture:check": "node scripts/check-module-boundaries.mjs",
		"deploy": "pnpm run build && node scripts/deploy-icloud.mjs",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
		"postversion": "node scripts/postversion.mjs",
		"release": "pnpm version --message \"chore(release): bump version to %s\" --tag-version-prefix \"\"",
		"fix": "vp check --fix",
		"check": "vp check && tsc --noEmit --skipLibCheck",
		"check:all": "pnpm run check && pnpm run architecture:check && pnpm run test",
		"setup-hooks": "node scripts/setup-hooks.mjs",
		"prepare": "node scripts/setup-hooks.mjs"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"lucide-react": "^1.72.0",
		"obsidian": "^1.14.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"ts-fsrs": "^6.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"sass": "^1.108.2",
		"tslib": "2.9.1",
		"typescript": "^7.0.2",
		"typescript-plugin-css-modules": "^5.3.0",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=26.13.0"
	},
	"packageManager": "pnpm@12.16.1"
}
